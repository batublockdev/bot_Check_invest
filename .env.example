# --- Core ---
DRY_RUN=true
LOG_LEVEL=info

# --- Blockchain (BNB Chain / BSC Mainnet, Chain ID 56) ---
BSC_RPC_URL=https://bsc-dataseed.binance.org
UNISWAP_QUOTER_ADDRESS=0x78D78E420Da98ad378D7799bE8f4AF69033EB077
BOT_PRIVATE_KEY=0xREPL…_KEY
TAG_ATTRIBUTION=

# --- Database (Railway PostgreSQL) ---
DATABASE_URL=postgresql://user:***@host:port/railway?sslmode=require

# --- Redis (Railway internal or Upstash) ---
REDIS_URL=redis://default:***@host:port

# --- Price Engine ---
PRICE_POLL_INTERVAL_MS=30000

# --- Evaluator ---
EVALUATOR_CONCURRENCY=5

# --- Executor ---
EXECUTOR_CONCURRENCY=2
TX_TIMEOUT_MS=120000

# --- Event Sync ---
EVENT_SYNC_INTERVAL_MS=20000
