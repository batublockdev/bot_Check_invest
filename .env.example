# Celo mainnet RPC (chain ID 42220)
CELO_RPC_URL=https://forno.celo.org

# Deployed StockWallet address
STOCKWALLET_ADDRESS=0xREPLACE_WITH_DEPLOYED_CONTRACT

# QuoterV2 address configured in your deployed StockWallet constructor
UNISWAP_QUOTER_ADDRESS=0xREPLACE_WITH_CELO_QUOTER_V2

# Private key of the bot account. Must already have ADGENT_ROLE on StockWallet.
# Never commit .env or share this key.
BOT_PRIVATE_KEY=0xREPLACE_WITH_PRIVATE_KEY

# Dry run defaults to true. Set false only after testing.
DRY_RUN=true
POLL_INTERVAL_MS=60000
# Allowed slippage used for buy planning only (buy execution not implemented yet)
MAX_SLIPPAGE_BPS=100
